{
  "name": "agro-input-verification-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run lint && npm run typecheck && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:logs": "docker compose logs --tail 50 postgres"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
